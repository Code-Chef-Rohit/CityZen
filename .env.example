# Supabase Primary Database Endpoint & Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Read Replica Configuration
# Set to your Supabase Read Replica URL (or multiple comma-separated URLs).
# If left equal to VITE_SUPABASE_URL or omitted, reads seamlessly execute on the Primary leader with automatic failover readiness.
# Example: VITE_SUPABASE_READ_REPLICA_URL=https://replica-db.your-project-id.supabase.co
VITE_SUPABASE_READ_REPLICA_URL=https://your-project-id.supabase.co

# OpenAI API Key for ZenAI Assistant
VITE_OPENAI_API_KEY=your-openai-api-key

# Automated Email Notifications (EmailJS)
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
