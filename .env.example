# Supabase Primary Database Endpoint & Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Read Replica Configuration
VITE_SUPABASE_READ_REPLICA_URL=https://your-project-id.supabase.co

# OpenAI API Key for ZenAI Assistant
VITE_OPENAI_API_KEY=your-openai-api-key

# Gmail SMTP Serverless Relay Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_SENDER_NAME=CityZen

# Client-accessible SMTP and Relay settings
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_ENDPOINT_URL=https://your-app.netlify.app/.netlify/functions/send-email

# Automated Email Notifications (EmailJS Fallback)
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
